# Canary reads. It never signs. Do not put a private key here.

# Robinhood Chain public RPC. Rate-limited; use Alchemy/QuickNode/etc. for production.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_WS_URL=

# Current Pons V2 factory from docs.ponsfamily.com/v2.
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# Watch wallet-held positions discovered from recent Pons V2 launches.
WALLETS=

# Optional direct token pins. Useful for old launches outside the index lookback.
TOKENS=

POLL_SECONDS=45

# Optional Telegram alerts.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Deterministic thresholds.
DEV_SELL_PCT=2
LIQUIDITY_DROP_PCT=15
VOLUME_DEAD_MINUTES=30
SERIAL_DEPLOYER_COUNT=12

# Public RPC protection. Launch indexing is chunked to avoid giant eth_getLogs calls.
INDEX_LOOKBACK_BLOCKS=400000
TRADE_LOOKBACK_BLOCKS=20000
LOG_CHUNK_BLOCKS=20000
DISCOVERY_MAX_TOKENS=250

# X handle shown in the local board header
CANARY_CREATOR_X=gippp69

# Optional backup read-only RPC endpoints, comma/semicolon separated
RPC_FALLBACK_URLS=

# Required to start/stop watchers through a reverse proxy or public host
CANARY_CONTROL_TOKEN=
