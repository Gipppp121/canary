{
  "name": "canary-chain",
  "version": "0.2.0",
  "description": "Read-only Pons V2 watchtower for Robinhood Chain. Deterministic alerts, no signer, no transaction writes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "canary": "./bin/canary.js"
  },
  "main": "./dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "watch": "tsx src/cli.ts watch",
    "doctor": "tsx src/cli.ts doctor",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "canary": "tsx src/cli.ts",
    "board": "tsx src/ui/web-board.ts",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "robinhood-chain",
    "pons",
    "watchtower",
    "read-only",
    "alerts",
    "memecoin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gipppp121/canary.git"
  },
  "bugs": {
    "url": "https://github.com/Gipppp121/canary/issues"
  },
  "homepage": "https://github.com/Gipppp121/canary#readme"
}
